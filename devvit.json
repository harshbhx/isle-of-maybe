{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "isle-of-maybe",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      },
      "_direct_launch": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT"]
    },
    "realtime": true,
    "media": true
  },
  "scheduler": {
    "tasks": {
      "daily-island": {
        "endpoint": "/internal/jobs/daily",
        "cron": "0 0 * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/install",
    "onPostDelete": "/internal/triggers/post-delete",
    "onCommentDelete": "/internal/triggers/comment-delete"
  },
  "menu": {
    "items": [
      {
        "label": "Isle of Maybe: Post today's island",
        "description": "Create today's island post if it is missing",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Isle of Maybe: Re-run daily job",
        "description": "Fill in anything today's job missed",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/rerun"
      },
      {
        "label": "Isle of Maybe: Review reported charts",
        "description": "Restore or delete charts hidden by player reports",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/review"
      }
    ]
  },
  "forms": {
    "reviewForm": "/internal/forms/review"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "settings": {
    "subreddit": {
      "crewGoal": {
        "type": "number",
        "label": "Crew goal: chests found per day",
        "helpText": "When the community finds this many chests in a day, the next island is Lantern night (DAY-8). Default 50.",
        "defaultValue": 50
      }
    }
  }
}
